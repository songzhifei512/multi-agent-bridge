# ============================================================================
# multi-agent-bridge环境变量示例模板（公网版）
# ============================================================================
#使用说明：
#1.复制此文件为 ~/.agents/.env（Windows: %USERPROFILE%\.agents\.env）
#2.将所有<xxx>占位符替换为你的真实 API密钥和端点
#3.重启 bridge服务使配置生效
#
#重要：所有密钥均为示例，必须替换为你的真实密钥！
#不要将此文件提交到版本控制系统！
# ============================================================================

# ============================================================================
#必填：主控 Agent（Claude Code）
# ============================================================================
# Anthropic (Claude) -主控/队长（推理/架构/审查）
#获取密钥：https://console.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=sk-ant-<YOUR_ANTHROPIC_API_KEY_HERE>

#模型配置（按实际可用填写）
#推荐：claude-sonnet-4-20250514（平衡性能与成本）
#可选：claude-opus-4-20250514（最强推理）
#可选：claude-haiku-4-20250514（最快最便宜）
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-20250514
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-20250514
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-20250514

# ============================================================================
#可选：Worker Agents
# ============================================================================

# ----------------------------------------------------------------------------
# OpenAI (Codex CLI) -执行/批量代码生成/长流程
#获取密钥：https://platform.openai.com
#安装 CLI: npm install -g @openai/codex
# ----------------------------------------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-<YOUR_OPENAI_API_KEY_HERE>

# ----------------------------------------------------------------------------
# Qwen (通义千问) -写文档/PPT +图像分析 (VL)
#获取密钥：https://bailian.console.aliyun.com
#说明：qwen是端点方式，无需独立 CLI，配置端点即可
# ----------------------------------------------------------------------------
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-<YOUR_QWEN_API_KEY_HERE>

# ----------------------------------------------------------------------------
# DSH (DeepSeek) -模型中立多后端执行者（轮换多个 provider 后端）
#获取密钥：https://platform.deepseek.com
#安装 CLI: npm install -g @deepseek-ai/dsh
# ----------------------------------------------------------------------------
DSH_BASE_URL=https://api.deepseek.com
DSH_API_KEY=sk-<YOUR_DEEPSEEK_API_KEY_HERE>

# ----------------------------------------------------------------------------
# opencode -限流备路/轻量并发推理
#说明：复用 OPENAI_BASE_URL和 OPENAI_API_KEY（OpenAI兼容端点）
#安装 CLI: npm install -g opencode-ai
#优化启动：export OPENCODE_DISABLE_MODELS_FETCH=1
# ----------------------------------------------------------------------------
#复用上方 OpenAI配置，无需额外密钥

# ============================================================================
#其他配置
# ============================================================================

#主控选择（决定哪个 CLI当队长）
#可选值：claude | codex | qwen | dsh
BRIDGE_CONTROLLER=claude

#状态目录（默认 ~/.agents/{state,work}，通常无需修改）
# BRIDGE_STATE_DIR=~/.agents/state
# BRIDGE_WORK_ROOT=~/.agents/work

# Web面板端口（默认3000）
# BRIDGE_WEB_PORT=3000

# ============================================================================
# Linux特定配置（通常无需修改）
# ============================================================================

# Linux向量层 glibc兼容（仅特定 glibc环境需要）
# LD_PRELOAD=<LIBRT_PATH>

# ============================================================================
# Vision-Analyze图像分析配置
# ============================================================================
# vision-analyze工具使用 Qwen的视觉语言模型（VL）进行图像分析
#配置同上 QWEN_BASE_URL和 QWEN_API_KEY
#使用方式：在 Claude会话中调用 /vision_analyze或通过 MCP工具调用
# ============================================================================
